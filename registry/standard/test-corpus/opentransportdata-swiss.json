  "title": {
    "de": "Open-Data-Plattform Mobilität Schweiz (opentransportdata.swiss)",
    "en": "Open Data Platform Mobility Switzerland (opentransportdata.swiss)"
  },
  "description": {
    "de": "Offizielle Open-Data-Plattform des Bundes für den öffentlichen Verkehr mit Fahrplan- und Echtzeitdaten. Zentrale KI-taugliche Schnittstelle ist der Open Journey Planner (OJP 2.0, XML über POST).",
    "en": "Official federal open data platform for Swiss public transport with timetable and real-time data. Its core machine interface is the Open Journey Planner API (OJP 2.0, XML over POST)."
  },
  "keyword": {
    "de": [
      "öffentlicher Verkehr",
      "Fahrplan",
      "OJP"
    ],
    "en": [
      "public transport",
      "timetable",
      "OJP"
    ]
  },
  "publisher": "https://ld.openhelvetia.swiss/org/ch-bav",
