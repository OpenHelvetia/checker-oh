  "interfaces": [
    {
      "@type": "RestInterface",
      "endpoint": "https://api.opentransportdata.swiss/ojp20",
      "docs": "https://opentransportdata.swiss/en/cookbook/open-journey-planner-ojp/",
      "auth": {
        "authType": "apikey",
        "docs": "https://api-manager.opentransportdata.swiss/"
      },
      "tier": "base",
      "probe": {
        "kind": "http-get",
        "expect": "response"
      }
    }
  ],
  "issued": "2026-08-15"
